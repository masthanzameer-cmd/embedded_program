#include <stdio.h>

int main()
{
    int a;

    printf("Enter num: ");
    scanf("%d", &a);

    if (a > 0)
    {
        printf("the number is positive : %d", a);
    }
    else if (a < 0)
    {
        printf("the number is negative : %d", a);
    }
    else
    {
        printf("Zero: %d", a);
    }

    return 0;
}
