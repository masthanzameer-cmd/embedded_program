#include <stdio.h>

int find_min_max(const int *a, int n,
                 int *min, int *max)
{
    if(a == NULL || min == NULL ||
       max == NULL || n <= 0)
        return -1;

    *min = *max = a[0];

    for(int i = 1; i < n; i++)
    {
        if(a[i] < *min)
            *min = a[i];

        if(a[i] > *max)
            *max = a[i];
    }

    return 0;
}

int main()
{
    int a[] = {7, 2, 9, 4, 1};
    int min, max;

    if(find_min_max(a, 5, &min, &max) == 0)
    {
        printf("Min = %d\n", min);
        printf("Max = %d", max);
    }

    return 0;
}
